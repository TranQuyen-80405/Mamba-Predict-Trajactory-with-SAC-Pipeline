# ── Virtual environments ───────────────────────────────────────────────
.venv/
.venv-linux/
.venv-linux-2404/
venv/
env_venv/
ENV/
!env/

# ── Python caches ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.executed.ipynb

# ── Editors / IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS junk ────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Stage A datasets (`data/`) are tracked in git for Colab clone-and-run.
data/*_bev_cache/

# ── Runtime / logs / checkpoints produced by training ──────────────────
# Track `runs/` (configs, metrics, checkpoints, logs). Root-level `checkpoints/` only.
logs/
wandb/
tb_logs/
lightning_logs/
/checkpoints/
*.log
!runs/**/*.log

# ── Large model artifacts (keep KITTI pretrained intentionally) ────────
# PointPillars_module/pretrained/epoch_160.pth is intentionally TRACKED.
# Any other checkpoint files elsewhere are ignored:
*.ckpt
*.pt
!PointPillars_module/pretrained/*.pth
!runs/**/*.pt

# ── Secrets ────────────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
credentials.json

# ── Build / packaging ──────────────────────────────────────────────────
build/
dist/
*.whl
