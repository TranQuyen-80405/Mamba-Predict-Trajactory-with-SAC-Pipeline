# ── Virtual environments ───────────────────────────────────────────────
.venv/
.venv-linux/
.venv-linux-2404/
venv/
env_venv/
ENV/
!env/

# ── Python caches ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.executed.ipynb

# ── Editors / IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS junk ────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Derived BEV / feature caches (large; regenerate locally) ────────────
**/*_bev_cache/

# ── Secrets ────────────────────────────────────────────────────────────
.env
.env.*
*.pem
*.key
credentials.json

# ── Build / packaging ──────────────────────────────────────────────────
build/
dist/
*.whl
